{
  "name": "talking",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.16.0",
  "scripts": {
    "lint": "echo (later)",
    "typecheck": "echo (later)",
      "test": "echo 'Tests will be added'",
      "test:unit": "echo 'Unit tests will be added'",
      "test:e2e": "echo 'E2E tests will be added'",
    "build": "pnpm -C apps/api build && pnpm -C apps/frontend build && pnpm -C apps/worker build",
    "dev:infra": "docker compose up -d",
    "dev:api": "pnpm -C apps/api start:dev",
    "dev:web": "pnpm -C apps/frontend dev",
    "dev:worker": "pnpm -C apps/worker dev",
    "dev:all": "pnpm dev:infra && concurrently -n API,WEB,WORKER -c auto \"pnpm -C apps/api start:dev\" \"pnpm -C apps/frontend dev\" \"pnpm -C apps/worker dev\"",
    "fix:asset:urls": "node apps/api/scripts/fix-asset-urls.mjs",
    "db:status": "pnpm -C apps/api exec prisma migrate status",
    "db:migrate": "pnpm -C apps/api prisma:migrate",
    "db:sync-game-references": "pnpm -C apps/api db:sync-game-references",
    "db:check-game-references": "pnpm -C apps/api db:check-game-references",
    "db:sync-game-credits": "pnpm -C apps/api db:sync-game-credits",
    "db:check-game-credits": "pnpm -C apps/api db:check-game-credits",
    "db:lock-game-credit-snapshots": "pnpm -C apps/api db:lock-game-credit-snapshots",
    "db:check-game-credit-snapshots": "pnpm -C apps/api db:check-game-credit-snapshots",
    "smoke:game-credits": "pnpm -C apps/api smoke:game-credits",
    "search:reindex": "pnpm -C apps/api search:reindex"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@nestjs/mapped-types": "^2.1.0",
    "@prisma/client": "^6.18.0"
  }
}
